    <!-- https://github.com/peteco-utfpr/grupos-pet/Campus -->

    <owl:Class rdf:about="https://github.com/peteco-utfpr/grupos-pet/Campus">
        <rdfs:subClassOf rdf:resource="https://github.com/peteco-utfpr/grupos-pet/GeographicLocation"/>
        <rdfs:comment xml:lang="en">A university campus is considered a location, typically identified by a name that often matches the name of the city in which it is situated. It is not a general rule, for instance, the UFPR has several campus at Curitiba: Histórico, Juvevê, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Campus</rdfs:label>
        <rdfs:label xml:lang="fr">Campus</rdfs:label>
        <rdfs:label xml:lang="pt-br">Campus</rdfs:label>
    </owl:Class>
    



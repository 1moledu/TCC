    <!-- https://github.com/peteco-utfpr/grupos-pet/hasCampus -->

    <owl:ObjectProperty rdf:about="https://github.com/peteco-utfpr/grupos-pet/hasCampus">
        <owl:inverseOf rdf:resource="https://github.com/peteco-utfpr/grupos-pet/isCampusOf"/>
        <rdfs:domain rdf:resource="https://github.com/peteco-utfpr/grupos-pet/University"/>
        <rdfs:range rdf:resource="https://github.com/peteco-utfpr/grupos-pet/Campus"/>
        <rdfs:comment xml:lang="en">A university has some campus</rdfs:comment>
        <rdfs:comment xml:lang="pt-br">Uma universidade tem vários campus.</rdfs:comment>
        <rdfs:label xml:lang="pt-br">tem_campus</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://github.com/peteco-utfpr/grupos-pet/hasDomain -->

    <owl:ObjectProperty rdf:about="https://github.com/peteco-utfpr/grupos-pet/hasDomain">
        <owl:inverseOf rdf:resource="https://github.com/peteco-utfpr/grupos-pet/isDomainOf"/>
        <rdfs:domain rdf:resource="https://github.com/peteco-utfpr/grupos-pet/PETactivity"/>
        <rdfs:range rdf:resource="https://github.com/peteco-utfpr/grupos-pet/DomainOfknowledge"/>
        <rdfs:comment xml:lang="en">A PET activity covers a specific domain of knowledge.</rdfs:comment>
        <rdfs:comment xml:lang="pt-br">Uma atividade PET abrange uma área de conhecimento específica.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://github.com/peteco-utfpr/grupos-pet/hasPETgroup -->

    <owl:ObjectProperty rdf:about="https://github.com/peteco-utfpr/grupos-pet/hasPETgroup">
        <owl:inverseOf rdf:resource="https://github.com/peteco-utfpr/grupos-pet/isPETgroupOf"/>
        <rdfs:domain rdf:resource="https://github.com/peteco-utfpr/grupos-pet/University"/>
        <rdfs:range rdf:resource="https://github.com/peteco-utfpr/grupos-pet/PETgroup"/>
        <rdfs:comment xml:lang="en">A university has a pet group</rdfs:comment>
        <rdfs:comment xml:lang="pt-br">Uma universidade tem um grupo PET.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://github.com/peteco-utfpr/grupos-pet/hasParticipatingGroup -->

    <owl:ObjectProperty rdf:about="https://github.com/peteco-utfpr/grupos-pet/hasParticipatingGroup">
        <owl:inverseOf rdf:resource="https://github.com/peteco-utfpr/grupos-pet/isParticipantOf"/>
        <rdfs:domain rdf:resource="https://github.com/peteco-utfpr/grupos-pet/PETactivity"/>
        <rdfs:range rdf:resource="https://github.com/peteco-utfpr/grupos-pet/PETgroup"/>
        <rdfs:comment xml:lang="en">An activity can be associated with one or more PET groups.</rdfs:comment>
        <rdfs:comment xml:lang="pt-br">Uma atividade pode estar vinculada a um ou mais grupos PET</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://github.com/peteco-utfpr/grupos-pet/isCampusOf -->

    <owl:ObjectProperty rdf:about="https://github.com/peteco-utfpr/grupos-pet/isCampusOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://github.com/peteco-utfpr/grupos-pet/Campus"/>
        <rdfs:range rdf:resource="https://github.com/peteco-utfpr/grupos-pet/University"/>
        <rdfs:comment xml:lang="en">A campus belongs to an University</rdfs:comment>
        <rdfs:comment xml:lang="pt-br">Um campus pertence a uma universidade.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://github.com/peteco-utfpr/grupos-pet/isDomainOf -->

    <owl:ObjectProperty rdf:about="https://github.com/peteco-utfpr/grupos-pet/isDomainOf">
        <rdfs:domain rdf:resource="https://github.com/peteco-utfpr/grupos-pet/DomainOfknowledge"/>
        <rdfs:range rdf:resource="https://github.com/peteco-utfpr/grupos-pet/PETactivity"/>
        <rdfs:comment xml:lang="en">A domain of knowledge is covered by a PET activity.</rdfs:comment>
        <rdfs:comment xml:lang="pt-br">Uma área de conhecimento é abordada por uma atividade PET.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://github.com/peteco-utfpr/grupos-pet/isLocatedIn -->

    <owl:ObjectProperty rdf:about="https://github.com/peteco-utfpr/grupos-pet/isLocatedIn">
        <rdfs:range rdf:resource="https://github.com/peteco-utfpr/grupos-pet/GeographicLocation"/>
        <rdfs:comment xml:lang="en">This is a general relation between a campus and the city it is located or between a city and its state. It can be used to every relation that aims to represent the fact that something is located at some place.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://github.com/peteco-utfpr/grupos-pet/isPETgroupOf -->

    <owl:ObjectProperty rdf:about="https://github.com/peteco-utfpr/grupos-pet/isPETgroupOf">
        <rdfs:domain rdf:resource="https://github.com/peteco-utfpr/grupos-pet/PETgroup"/>
        <rdfs:range rdf:resource="https://github.com/peteco-utfpr/grupos-pet/University"/>
        <rdfs:comment xml:lang="en">A PET group belongs to or is part of an university.</rdfs:comment>
        <rdfs:comment xml:lang="pt-br">Um grupo PET pertence a uma universidade.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://github.com/peteco-utfpr/grupos-pet/isParticipantOf -->

    <owl:ObjectProperty rdf:about="https://github.com/peteco-utfpr/grupos-pet/isParticipantOf">

    <!-- https://github.com/peteco-utfpr/grupos-pet/DomainOfknowledge -->

    <owl:Class rdf:about="https://github.com/peteco-utfpr/grupos-pet/DomainOfknowledge">
        <rdfs:comment xml:lang="en">It is used to classify a PET activity under specific fields of knowledge. For example, a short course can cover topics in computer science and psychology.</rdfs:comment>

        <rdfs:range rdf:resource="https://github.com/peteco-utfpr/grupos-pet/PETactivity"/>
        <rdfs:comment xml:lang="en">A PET Group can be associated with one or more activities.</rdfs:comment>
        <rdfs:comment xml:lang="pt-br">Um grupo PET pode estar associado a uma ou mais atividades.</rdfs:comment>
    </owl:ObjectProperty>
    


